# Backlog MCP — Multi-space configuration
#
# Add as many Backlog spaces as you need by repeating the three-variable pattern:
#
#   BACKLOG_API_KEY_<NAME>=...
#   BACKLOG_HOST_<NAME>=...
#   PROJECT_KEY_<NAME>=...
#
# <NAME> becomes the source identifier (lowercased) used in all tool calls.
# Optionally set DEFAULT_SOURCE to control which source is used when none is specified.

# ── Space 1 ───────────────────────────────────────────────────────────────────
BACKLOG_API_KEY_YST=your_yst_api_key_here
BACKLOG_HOST_YST=keieikika.backlog.com
PROJECT_KEY_YST=KANTAKIWIZKEIZOKUKAIHATSU

# ── Space 2 ───────────────────────────────────────────────────────────────────
BACKLOG_API_KEY_VTI=your_vti_api_key_here
BACKLOG_HOST_VTI=vti-corp.backlog.com
PROJECT_KEY_VTI=YST_KANTAKI_WIZ

# ── Space N (add as many as needed) ──────────────────────────────────────────
# BACKLOG_API_KEY_ACME=your_acme_api_key_here
# BACKLOG_HOST_ACME=acme.backlog.com
# PROJECT_KEY_ACME=ACME_PROJECT_KEY

# ── Default source (optional) ────────────────────────────────────────────────
# If not set, the first detected source is used as default.
# DEFAULT_SOURCE=yst
